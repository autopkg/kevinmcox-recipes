<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Description</key>
	<string>Downloads, packages and installs the latest version of DFU Blaster Pro (https://twocanoes.com/products/mac/dfu-blaster/). Parents onto mlbz521-recipes' pkg, which flattens the vendor pkg out of the downloaded disk image.</string>
	<key>Identifier</key>
	<string>com.github.kevinmcox.install.DFUBlaster</string>
	<key>Input</key>
	<dict>
		<key>NAME</key>
		<string>DFUBlaster</string>
	</dict>
	<key>MinimumVersion</key>
	<string>2.3</string>
	<key>ParentRecipe</key>
	<string>com.github.mlbz521.pkg.DFUBlaster</string>
	<key>Process</key>
	<array>
		<dict>
			<key>Processor</key>
			<string>Installer</string>
		</dict>
	</array>
</dict>
</plist>
